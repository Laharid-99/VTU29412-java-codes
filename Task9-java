import java.util.*;

public class Task9 {
    public static int[] shuffle(int[] nums, int n) {
        int[] result = new int[2 * n];
        int j = 0;

        for (int i = 0; i < n; i++) {
            result[j++] = nums[i];
            result[j++] = nums[i + n];
        }

        return result;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[2 * n];

        for (int i = 0; i < 2 * n; i++) {
            nums[i] = sc.nextInt();
        }

        int[] ans = shuffle(nums, n);

        for (int x : ans) {
            System.out.print(x + " ");
        }

        sc.close();
    }
}
